# Shared demo controls
# Keep true for a public portfolio demo. Set false only when pointing at a real/shared database.
APP_SEED_DEMO=true

# Optional extra guard for API-triggered demo reset. Use a long random value in hosted demos.
APP_DEMO_RESET_SECRET=change-me-for-hosted-demo

# Private analytics page owner code. Open /analytics on the frontend and enter this value.
# Keep it out of frontend env vars; only the backend should know the real code.
APP_ANALYTICS_OWNER_KEY=change-me-for-private-analytics
APP_ANALYTICS_ENABLED=true

# Backend
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/workforce_hcm
SPRING_DATASOURCE_USERNAME=workforce
SPRING_DATASOURCE_PASSWORD=workforce

# Production/public demo value must be unique and at least 32 characters.
APP_JWT_SECRET=replace-with-at-least-32-characters-for-prod

# Comma-separated browser origins allowed to call the API.
# Local Vite: http://localhost:5173
# Local Docker frontend: http://localhost:3000
# Hosted demo: https://your-frontend.example.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional comma-separated patterns. Useful for Vercel preview/production URLs.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://*.vercel.app

# Frontend
# Browser-facing backend API URL. For hosted demos, use the public backend HTTPS URL.
VITE_API_BASE_URL=http://localhost:8080/api/v1
